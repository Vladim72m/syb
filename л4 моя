CREATE PROCEDURE count_stud
    @faculty_name NVARCHAR(200),
    @form_name NVARCHAR(200)
AS BEGIN
    SELECT COUNT(stud.id) AS stud_count
    FROM stud
    JOIN process ON stud.id = process.stud_id
    JOIN hours ON process.hours_id = hours.id
    JOIN faculty ON hours.faculty_id = faculty.id
    JOIN form ON hours.form_id = form.id
    WHERE faculty.faculty_name = @faculty_name
      AND form.form_name = @form_name;
END
GO


GO
CREATE PROCEDURE count_sub
    @cnt_econ INT OUTPUT,
    @cnt_math INT OUTPUT,
    @cnt_total INT OUTPUT,
    @cnt_same INT OUTPUT
AS BEGIN
    SELECT @cnt_econ = COUNT(*)
    FROM hours
    JOIN faculty ON hours.faculty_id = faculty.id
    WHERE faculty.faculty_name = 'Экономисты';

    SELECT @cnt_math = COUNT(*)
    FROM hours
    JOIN faculty ON hours.faculty_id = faculty.id
    WHERE faculty.faculty_name = 'Математики';

    SELECT @cnt_total = COUNT(*) FROM hours;

    SELECT @cnt_same = COUNT(*)
    FROM hours
    GROUP BY course
    HAVING COUNT(*) > 1;

    PRINT 'Экономисты: ' + CAST(@cnt_econ AS NVARCHAR);
    PRINT 'Математики: ' + CAST(@cnt_math AS NVARCHAR);
    PRINT 'Всего: ' + CAST(@cnt_total AS NVARCHAR);
    PRINT 'Одинаковых курсов: ' + CAST(@cnt_same AS NVARCHAR);
END
